# ============================================
# VARIÁVEIS DE AMBIENTE - STOKBLEND API
# ============================================

# Servidor
PORT=3500
NODE_ENV=development

# Banco de Dados
DATABASE_URL='mongodb+srv://sa:sa2025@hendasoft.egbvpla.mongodb.net/?appName=hendasoft'

# Rate Limiting
# Limite de requisições por IP (requisições/minuto)
IP_MAX_REQUESTS=100
IP_WINDOW_MS=60000

# Limite de requisições por Token (requisições/minuto)
TOKEN_MAX_REQUESTS=200
TOKEN_WINDOW_MS=60000

# Timeouts (em ms)
REQUEST_TIMEOUT=15000
DATABASE_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Segurança
CORS_ORIGIN=*

# Nota: Mantenha este arquivo seguro e não commit no repositório
